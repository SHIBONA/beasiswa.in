{
  "name": "beasiswa-in",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "beasiswa.in: agen pencari beasiswa (prototipe demo).",
  "scripts": {
    "dev": "bun scripts/start.ts --dev",
    "build": "bun run --cwd web build",
    "start": "bun scripts/start.ts",
    "test": "bun test",
    "typecheck": "tsc -p . && bun run --cwd web typecheck",
    "test:browser": "bun run build && bun --bun e2e run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@beasiswa/shared": "workspace:*"
  },
  "devDependencies": {
    "@e2e-dev/core": "0.25.0",
    "@e2e-dev/web": "0.17.0",
    "@types/bun": "1.4.5",
    "e2e": "0.25.0",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "shared",
    "web"
  ]
}
